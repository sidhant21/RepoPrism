# Server Port (default 3001)
PORT=3001

# Optional: GitHub Personal Access Token to increase API rate limit to 5,000 req/hr
# Create one at: https://github.com/settings/tokens (classic with 'public_repo' or read-only)
GITHUB_TOKEN=

# Google Gemini API Key for Gemini 2.5 Flash structured analysis
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
