{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd repoprism-app && npm install && npm run build",
  "outputDirectory": "repoprism-app/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
